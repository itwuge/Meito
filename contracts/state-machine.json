{
  "contractVersion": "0.3.2",
  "initial": "idle",
  "states": [
    { "name": "idle", "terminal": false },
    { "name": "preflight", "terminal": false },
    { "name": "dispatching", "terminal": false },
    { "name": "queued", "terminal": false },
    { "name": "runner_starting", "terminal": false },
    { "name": "p2p_connecting", "terminal": false },
    { "name": "link_ready", "terminal": false },
    { "name": "waiting_for_join", "terminal": false },
    { "name": "entry_starting", "terminal": false },
    { "name": "connected", "terminal": false },
    { "name": "reconnecting", "terminal": false },
    { "name": "ending", "terminal": false },
    { "name": "collecting", "terminal": false },
    { "name": "done", "terminal": true },
    { "name": "cancelled", "terminal": true },
    { "name": "failed_preflight", "terminal": true },
    { "name": "failed_dispatch", "terminal": true },
    { "name": "failed_queue_timeout", "terminal": true },
    { "name": "failed_bootstrap", "terminal": true },
    { "name": "failed_p2p", "terminal": true },
    { "name": "failed_link", "terminal": true },
    { "name": "failed_entry", "terminal": true },
    { "name": "failed_collect", "terminal": true },
    { "name": "no_direct_path", "terminal": true },
    { "name": "orphaned", "terminal": true }
  ],
  "events": [
    "start",
    "preflight_ok",
    "preflight_failed",
    "dispatch_ok",
    "dispatch_failed",
    "queue_timeout",
    "runner_ready",
    "runner_failed",
    "p2p_ok",
    "p2p_failed",
    "no_direct_path",
    "link_ready",
    "link_failed",
    "join",
    "join_timeout",
    "entry_ready",
    "entry_failed",
    "connect_ok",
    "disconnect",
    "reconnect_ok",
    "reconnect_failed",
    "stop",
    "force_stop",
    "collect_ok",
    "collect_failed",
    "checkpoint",
    "orphan_detect"
  ],
  "transitions": [
    { "from": "idle", "event": "start", "to": "preflight" },
    { "from": "preflight", "event": "preflight_ok", "to": "dispatching" },
    { "from": "preflight", "event": "preflight_failed", "to": "failed_preflight" },
    { "from": "dispatching", "event": "dispatch_ok", "to": "queued" },
    { "from": "dispatching", "event": "dispatch_failed", "to": "failed_dispatch" },
    { "from": "queued", "event": "runner_ready", "to": "runner_starting" },
    { "from": "queued", "event": "queue_timeout", "to": "failed_queue_timeout" },
    { "from": "runner_starting", "event": "runner_ready", "to": "p2p_connecting" },
    { "from": "runner_starting", "event": "runner_failed", "to": "failed_bootstrap" },
    { "from": "p2p_connecting", "event": "p2p_ok", "to": "link_ready" },
    { "from": "p2p_connecting", "event": "p2p_failed", "to": "failed_p2p" },
    { "from": "p2p_connecting", "event": "no_direct_path", "to": "no_direct_path" },
    { "from": "link_ready", "event": "link_ready", "to": "waiting_for_join" },
    { "from": "link_ready", "event": "link_failed", "to": "failed_link" },
    { "from": "waiting_for_join", "event": "join", "to": "entry_starting" },
    { "from": "waiting_for_join", "event": "join_timeout", "to": "cancelled" },
    { "from": "entry_starting", "event": "entry_ready", "to": "connected" },
    { "from": "entry_starting", "event": "entry_failed", "to": "failed_entry" },
    { "from": "connected", "event": "disconnect", "to": "reconnecting" },
    { "from": "reconnecting", "event": "reconnect_ok", "to": "connected" },
    { "from": "reconnecting", "event": "reconnect_failed", "to": "failed_p2p" },
    { "from": "connected", "event": "stop", "to": "ending" },
    { "from": "waiting_for_join", "event": "stop", "to": "ending" },
    { "from": "entry_starting", "event": "stop", "to": "ending" },
    { "from": "reconnecting", "event": "stop", "to": "ending" },
    { "from": "ending", "event": "collect_ok", "to": "collecting" },
    { "from": "ending", "event": "collect_failed", "to": "failed_collect" },
    { "from": "collecting", "event": "collect_ok", "to": "done" },
    { "from": "collecting", "event": "collect_failed", "to": "failed_collect" },
    { "from": "connected", "event": "force_stop", "to": "cancelled" },
    { "from": "waiting_for_join", "event": "force_stop", "to": "cancelled" },
    { "from": "p2p_connecting", "event": "stop", "to": "ending" },
    { "from": "orphaned", "event": "stop", "to": "cancelled" }
  ],
  "timeouts": {
    "jobHardLimitMinutes": 360,
    "sessionDefaultMinutes": 60,
    "sessionMaxMinutes": 300,
    "idleMinutes": 10,
    "noJoinMinutes": 5,
    "checkpointBeforeMaxMinutes": 10,
    "reconnectMaxSsh": 3,
    "reconnectMaxIce": 2
  },
  "autoCancel": [
    { "when": "waiting_for_join", "timeout": "noJoinMinutes", "event": "join_timeout", "errorCode": "E_NO_JOIN_TIMEOUT" },
    { "when": "connected", "timeout": "idleMinutes", "event": "stop", "errorCode": "E_JOB_TIMEOUT" },
    { "when": "connected", "timeout": "sessionMaxMinutes", "event": "stop", "errorCode": "E_JOB_TIMEOUT" },
    { "when": "reconnecting", "timeout": "reconnectMaxSsh", "event": "reconnect_failed", "errorCode": "E_P2P_XTCP" }
  ]
}
