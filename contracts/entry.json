{
  "contractVersion": "0.3.6",
  "purpose": "入口监听端口与回环绑定约束；代码、脚本与文档必须从这里读取，不得另写数值。V1 用户入口只有浏览器 WebSocket 终端（ttyd 形态），SSH 入口与图形入口均不支持",
  "requiredness": {
    "bind.address": "required",
    "bind.loopbackOnly": "required",
    "bind.allowWildcardBind": "required",
    "ports.terminal": "required",
    "terminal.writeFlag": "required",
    "terminal.singleClientFlag": "required",
    "terminal.originCheckFlag": "required",
    "ports.graphical": "not-applicable",
    "ports.vnc": "not-applicable",
    "graphical.framebuffer": "not-applicable",
    "graphical.vncPasswordChars": "not-applicable",
    "graphical.vncPasswordDesOnly": "not-applicable"
  },
  "bind": {
    "address": "127.0.0.1",
    "loopbackOnly": true,
    "allowWildcardBind": false,
    "wildcardAddress": "0.0.0.0"
  },
  "ports": {
    "terminal": 7681,
    "graphical": 6080,
    "vnc": 5900
  },
  "terminal": {
    "implementation": "ttyd",
    "webSocket": true,
    "publicPort": 443,
    "tuiSupport": "full",
    "menuconfigSupported": true,
    "writeFlag": "-W",
    "singleClientFlag": "-m 1",
    "originCheckFlag": "-O"
  },
  "graphical": {
    "status": "not-supported",
    "v1Enabled": false,
    "reason": "V1 明确不做图形入口；ssh -X 随 SSH 入口移除一并失效；浏览器内 VNC 复用 443 WebSocket 仅作为后续候选留档，不在 V1 落地",
    "implementation": "deferred",
    "futureTransport": "browser-vnc-over-443-websocket",
    "futureCandidates": ["KasmVNC", "noVNC"],
    "framebuffer": {
      "width": 1280,
      "height": 800,
      "depth": 24
    },
    "vncPasswordChars": 8,
    "vncPasswordDesOnly": true
  },
  "v1GraphicalFallback": {
    "status": "not-supported",
    "v1Enabled": false,
    "removed": ["ssh-x11-forwarding"],
    "removalReason": "V1 不提供 SSH 入口，ssh -X 兜底随之失效；不保留半截图形路线",
    "futureCandidate": "browser-vnc-over-443-websocket",
    "futureCandidates": ["KasmVNC", "noVNC"],
    "webDecision": "kasmvnc-preferred-novnc-fallback"
  }
}
